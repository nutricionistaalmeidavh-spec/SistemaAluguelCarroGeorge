{
  "name": "daily-billing",
  "steps": [
    {
      "action": "fill",
      "label": "Usuário",
      "value": "admin"
    },
    {
      "action": "fill",
      "label": "Senha",
      "valueFromEnv": "LOCADORA_QA_ADMIN_PASSWORD"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Entrar"
    },
    {
      "action": "click",
      "selector": "[data-nav=\"clientes\"]"
    },
    {
      "action": "click",
      "selector": "#new-customer"
    },
    {
      "action": "fill",
      "selector": "#customer-form [name=\"name\"]",
      "value": "Cliente Diária QA"
    },
    {
      "action": "fill",
      "selector": "#customer-form [name=\"document\"]",
      "value": "98765432100"
    },
    {
      "action": "fill",
      "selector": "#customer-form [name=\"phone\"]",
      "value": "16999998888"
    },
    {
      "action": "click",
      "selector": "#customer-form button.primary"
    },
    {
      "action": "click",
      "selector": "[data-nav=\"frota\"]"
    },
    {
      "action": "click",
      "selector": "#new-vehicle"
    },
    {
      "action": "fill",
      "selector": "#vehicle-form [name=\"model\"]",
      "value": "Onix Diária QA"
    },
    {
      "action": "fill",
      "selector": "#vehicle-form [name=\"plate\"]",
      "value": "DIA1A23"
    },
    {
      "action": "fill",
      "selector": "#vehicle-form [name=\"dailyRate\"]",
      "value": "100"
    },
    {
      "action": "click",
      "selector": "#vehicle-form button.primary"
    },
    {
      "action": "click",
      "selector": "[data-nav=\"reservas\"]"
    },
    {
      "action": "click",
      "selector": "#new-rental"
    },
    {
      "action": "fill",
      "selector": "#rental-form [name=\"pickupAt\"]",
      "value": "10/02/2030 10:00"
    },
    {
      "action": "fill",
      "selector": "#rental-form [name=\"returnAt\"]",
      "value": "13/02/2030 10:00"
    },
    {
      "action": "click",
      "selector": "details.rental-advanced summary"
    },
    {
      "action": "selectOption",
      "selector": "#rental-form [name=\"billingMode\"]",
      "value": "daily"
    },
    {
      "action": "click",
      "selector": "#rental-form button.primary"
    },
    {
      "action": "expectVisible",
      "selector": "[data-rental-payment]"
    },
    {
      "action": "click",
      "selector": "[data-rental-payment]"
    },
    {
      "action": "expectText",
      "selector": ".modal",
      "expected": "Receber pagamento"
    },
    {
      "action": "expectVisible",
      "selector": "[data-payment-quick]"
    },
    {
      "action": "click",
      "selector": "#daily-payment-form button.primary"
    },
    {
      "action": "screenshot",
      "name": "daily-payment-unified",
      "fullPage": true
    }
  ]
}
